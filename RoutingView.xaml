<Page x:Class="FastTrackLogistics.Views.RoutingView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="RoutingView">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <DataGrid x:Name="RoutesGrid" AutoGenerateColumns="False" CanUserAddRows="True" IsReadOnly="False" RowHeight="40">
            <DataGrid.Columns>
                <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="80"/>
                <DataGridTextColumn Header="Назначение" Binding="{Binding Destination}" Width="*"/>
                <DataGridTextColumn Header="Дистанция" Binding="{Binding Distance}" Width="100"/>
                <DataGridTextColumn Header="Статус" Binding="{Binding Status}" Width="120"/>
                <DataGridTextColumn Header="ETA" Binding="{Binding ETA}" Width="100"/>
            </DataGrid.Columns>
        </DataGrid>

        <Button Grid.Row="1" Content="Сохранить изменения" Click="SaveChanges_Click" 
                HorizontalAlignment="Right" Margin="0,20,0,0" Padding="20,10" 
                Background="#6A716F" Foreground="White" BorderThickness="0"/>
    </Grid>
</Page>