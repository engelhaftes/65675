<Page x:Class="FastTrackLogistics.Views.TrackingView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="TrackingView">

    <Grid Margin="20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1*"/>
            <ColumnDefinition Width="350"/>
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0" Margin="0,0,20,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="White" CornerRadius="10" Margin="0,0,0,15" Padding="10">
                <DockPanel>
                    <TextBlock Text="🔍" VerticalAlignment="Center" Margin="5,0,10,0" Opacity="0.5"/>
                    <TextBox x:Name="SearchBox" BorderThickness="0" VerticalContentAlignment="Center" 
                             FontSize="14" Foreground="#6A716F" Tag="Поиск по ID или городу..."
                             TextChanged="SearchBox_TextChanged"/>
                </DockPanel>
            </Border>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="TrackingList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Background="Transparent" BorderThickness="0" Click="Card_Click" Margin="0,0,0,10">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="White" Padding="15" CornerRadius="12" x:Name="CardBorder">
                                            <Border.Effect>
                                                <DropShadowEffect BlurRadius="10" ShadowDepth="1" Opacity="0.05"/>
                                            </Border.Effect>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <StackPanel>
                                                    <TextBlock Text="{Binding CargoId}" FontWeight="Bold" FontSize="16" Foreground="#6A716F"/>
                                                    <TextBlock Text="{Binding CurrentLocation}" Foreground="#A6C4BC" Margin="0,5"/>
                                                    <ProgressBar Value="{Binding Progress}" Height="6" Width="200" HorizontalAlignment="Left" Foreground="#A6C4BC"/>
                                                </StackPanel>

                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <Border Background="{Binding StatusColor}" CornerRadius="5" Padding="8,3">
                                                        <TextBlock Text="{Binding StatusText}" Foreground="White" FontSize="10" FontWeight="Bold"/>
                                                    </Border>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="CardBorder" Property="Background" Value="#F9FBFB"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>

        <Border Grid.Column="1" Background="#6A716F" CornerRadius="15" Padding="20">
            <StackPanel x:Name="DetailsPanel" Visibility="Collapsed">
                <TextBlock Text="Детали груза" Foreground="White" Opacity="0.6" Margin="0,0,0,10"/>
                <TextBlock x:Name="DetailId" Text="#0000" Foreground="White" FontSize="22" FontWeight="Bold"/>

                <Separator Margin="0,20" Opacity="0.2"/>

                <TextBlock Text="Маршрутные точки:" Foreground="White" Margin="0,0,0,10"/>
                <ItemsControl x:Name="HistoryList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <BulletDecorator Margin="0,5">
                                <BulletDecorator.Bullet>
                                    <Ellipse Width="6" Height="6" Fill="#A6C4BC"/>
                                </BulletDecorator.Bullet>
                                <TextBlock Text="{Binding}" Foreground="White" Margin="10,0,0,0" Opacity="0.8"/>
                            </BulletDecorator>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Button Content="Приостановить" Margin="0,30,0,10" Background="#E74C3C" Foreground="White" BorderThickness="0" Padding="10" Click="Action_Click"/>
                <Button Content="Экспорт лога" Background="Transparent" Foreground="White" BorderThickness="1" BorderBrush="White" Padding="10" Click="Action_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</Page>