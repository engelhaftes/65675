<Window x:Class="FastTrackLogistics.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FastTrack Logistics System" Height="850" Width="1350"
        WindowStartupLocation="CenterScreen" Background="#F0F2F1"
        FontFamily="Segoe UI">

    <Window.Resources>
        <SolidColorBrush x:Key="PrimaryGreen" Color="#A6C4BC"/>
        <SolidColorBrush x:Key="DeepGray" Color="#6A716F"/>

        <Style x:Key="NavButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Height" Value="55"/>
            <Setter Property="Margin" Value="10,5"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="12">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center" Margin="20,0,0,0"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#7A817F"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="280"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="{StaticResource DeepGray}">
            <Grid>
                <StackPanel Margin="0,30,0,0">
                    <TextBlock Text="ФАСТТРЭК" Foreground="{StaticResource PrimaryGreen}" 
                               FontSize="22" FontWeight="Black" HorizontalAlignment="Center" Margin="0,0,0,40"/>

                    <Button Content="🛤 Маршрутизация" Style="{StaticResource NavButtonStyle}" Click="NavRouting_Click"/>
                    <Button Content="📍 Отслеживание" Style="{StaticResource NavButtonStyle}" Click="NavTracking_Click"/>
                    <Button Content="🔗 Интеграция" Style="{StaticResource NavButtonStyle}" Click="NavIntegration_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="70"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="White">
                <TextBlock x:Name="TxtHeader" Text="Панель управления" VerticalAlignment="Center" 
                           Margin="30,0" FontSize="20" Foreground="{StaticResource DeepGray}" FontWeight="Bold"/>
            </Border>

            <Frame x:Name="MainFrame" Grid.Row="1" NavigationUIVisibility="Hidden" Margin="20"/>
        </Grid>
    </Grid>
</Window>